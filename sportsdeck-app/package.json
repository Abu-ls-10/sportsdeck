{
  "name": "sportsdeck-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env PRISMA_CLI_QUERY_ENGINE_TYPE=binary PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate && cross-env PRISMA_CLI_QUERY_ENGINE_TYPE=binary PRISMA_CLIENT_ENGINE_TYPE=binary next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "studio": "cross-env PRISMA_CLI_QUERY_ENGINE_TYPE=binary PRISMA_CLIENT_ENGINE_TYPE=binary prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:generate:binary": "cross-env PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate",
    "dev:binary": "cross-env PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate && cross-env PRISMA_CLIENT_ENGINE_TYPE=binary next dev",
    "studio:binary": "cross-env PRISMA_CLIENT_ENGINE_TYPE=binary prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@prisma/adapter-pg": "^7.5.0",
    "@tabler/icons-react": "^3.40.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.0.1",
    "next": "16.1.6",
    "next-swagger-doc": "^0.4.1",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "uuid": "^13.0.0"
