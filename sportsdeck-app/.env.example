# Copy to `.env` in this directory. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Redis (caching / rate limiting)
# -----------------------------------------------------------------------------
# Docker Compose: the `app` service defaults to redis://redis:6379 on the
# internal network. Set REDIS_URL here only to override (e.g. external Redis).
# Local `npm run dev` with Redis from compose (`ports: 6379:6379`):
#   REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Required when using `docker compose` (values are passed into the app container)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d
SALT_ROUNDS=10
HUGGINGFACE_API_KEY=
X_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Local development (when not using Compose for the app)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://sportsdeck:sportsdeck@localhost:5432/sportsdeck
NEXT_PUBLIC_APP_URL=http://localhost:3000
