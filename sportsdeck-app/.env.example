# Copy to `.env` in this directory. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Redis (caching / rate limiting) — see `redis` service in docker-compose.yaml
# -----------------------------------------------------------------------------
# Docker Compose: do NOT set REDIS_URL to 127.0.0.1 — inside the app container
# that points to the app itself, not Redis. Omit REDIS_URL (compose defaults to
# redis://redis:6379) or set REDIS_URL=redis://redis:6379 explicitly.
# Local `npm run dev` with Redis on the host (e.g. compose exposes 6379:6379):
# REDIS_URL=redis://127.0.0.1:6379

# Background cache warmer (Docker / long-lived Node only). Set to 0 or false to disable.
# Requires REDIS_URL and X_AUTH_TOKEN.
# CACHE_WARMER=1

# Optional Redis rate limits (fixed window). Omit to use defaults.
# RL_SIGNUP_MAX_PER_IP=10
# RL_SIGNUP_WINDOW_SECONDS=3600
# RL_REFRESH_MAX_PER_IP=120
# RL_REFRESH_WINDOW_SECONDS=900
# RL_TRANSLATE_MAX_PER_USER=40
# RL_TRANSLATE_WINDOW_SECONDS=3600
# RL_SENTIMENT_MAX_PER_IP_THREAD=20
# RL_SENTIMENT_WINDOW_SECONDS=3600
# RL_ADMIN_ANALYZE_MAX_PER_ADMIN=30
# RL_ADMIN_ANALYZE_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# Required when using `docker compose` (values are passed into the app container)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d
SALT_ROUNDS=10
HUGGINGFACE_API_KEY=
X_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Local development (when not using Compose for the app)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://sportsdeck:sportsdeck@localhost:5432/sportsdeck
NEXT_PUBLIC_APP_URL=http://localhost:3000
